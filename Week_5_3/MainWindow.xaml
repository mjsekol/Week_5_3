<Window x:Class="Week_5_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Week_5_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="450">
    <StackPanel Orientation="Vertical">
        <Label Content="First Name" Margin="20,15,0,0"/>
        <TextBox Name="txtFirstName" Margin="20,0,20,0"/>
        <Label Content="Last Name" Margin="20,15,0,0"/>
        <TextBox Name="txtLastName" Margin="20,0,20,0"/>
        <Button MaxWidth="200" Content="Enter" Foreground="Azure" Background="DarkOliveGreen" FontSize="25" Margin="0,15,0,0"></Button>
    </StackPanel>
</Window>
